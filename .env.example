# Aplicação
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
NEXT_PUBLIC_GA_ID=
# Contato público (e-mail, WhatsApp, LinkedIn, GitHub, Instagram), textos
# institucionais e foto ficam em /admin/configuracoes, não em variáveis.

# Supabase Cloud — URL HTTPS e chave pública sb_publishable_...
# A home ainda usa constantes; estes valores são obrigatórios para os clientes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project ref para ferramentas de desenvolvimento (não é segredo).
# Para a CLI, exportar no terminal; npm não carrega .env.local automaticamente.
SUPABASE_PROJECT_ID=
# Chave privilegiada (sb_secret_...), somente no servidor: é o que permite
# gravar os contatos recebidos pelo formulário público. Sem ela o site continua
# funcionando, mas os leads não são registrados no painel.
# Nunca adicionar o prefixo NEXT_PUBLIC_ e nunca versionar o valor.
SUPABASE_SECRET_KEY=

# Contato / Resend
# Este arquivo é versionado: só placeholders, nunca valores reais.
# A chave e os e-mails vão no .env.local, que o Git ignora.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Site JHConsulting <site@seudominio.com.br>
CONTACT_TO_EMAIL=contato@seudominio.com.br
